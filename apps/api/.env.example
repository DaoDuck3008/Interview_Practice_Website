# Enviroment configs
NODE_ENV=development
PORT=3001
TZ=UTC

DATABASE_URL=

# Google OAuth configs
GOOGLE_CLIENT_ID=

# JWT authentication configs
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Redis - allowlist refresh token (thu hồi phiên khi logout)
# Cổng host 6380 để tránh xung đột với Redis của project khác (mặc định 6379)
REDIS_URL=redis://localhost:6380

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Bucket này không được bật r2.dev hoặc custom domain public vì chứa CV của người dùng.
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_URL=

# Groq AI configs - serve transating speech to text module
GROQ_API_KEY=

# DeepSeek AI configs -serve scoring module
DEEPSEEK_API_KEY=

# Sepay configs
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=

# Resend configs
RESEND_API_KEY=
MAIL_FROM=

# Maximum number of concurrency requests send to DeepSeek
AI_QUEUE_CONCURRENCY=5
