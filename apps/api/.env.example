# Enviroment configs
NODE_ENV=development
PORT=3001

DATABASE_URL=

# JWT authentication configs
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Redis - allowlist refresh token (thu hồi phiên khi logout)
REDIS_URL=redis://localhost:6379

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Groq AI configs - serve transating speech to text module
GROQ_API_KEY=

# DeepSeek AI configs -serve scoring module
DEEPSEEK_API_KEY=