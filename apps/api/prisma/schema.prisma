generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Level {
  EASY
  MEDIUM
  HARD
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum OrderStatus {
  PENDING // vừa tạo, chờ chuyển khoản
  PAID //    Sepay xác nhận đã nhận tiền
  EXPIRED // quá hạn QR mà chưa trả
  CANCELED // user/admin hủy
  FAILED //  tiền về nhưng không khớp (sai số tiền…) — xử lý tay
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
  WEBHOOK
}

enum AuditAction {
  USER_REGISTER
  USER_VERIFY_EMAIL
  USER_CHANGE_PASSWORD
  USER_RESET_PASSWORD
  USER_LOCK
  USER_UNLOCK
  USER_MANUAL_VERIFY

  PLAN_CREATE
  PLAN_UPDATE
  PLAN_DELETE

  TOPIC_CREATE
  TOPIC_UPDATE
  TOPIC_UPLOAD_ICON
  TOPIC_DELETE

  QUESTION_CREATE
  QUESTION_UPDATE
  QUESTION_SOFT_DELETE

  CHECKOUT_CREATE
  PAYMENT_WEBHOOK_PAID
  PAYMENT_WEBHOOK_FAILED
  PAYMENT_WEBHOOK_IGNORED
  PAYMENT_ADMIN_VIEW_DETAIL
  PAYMENT_EXPORT

  SUBSCRIPTION_CANCEL
  SUBSCRIPTION_ACTIVATE
  SUBSCRIPTION_GRANT
  SUBSCRIPTION_EXPIRE_CRON

  SESSION_CREATE
  SCORE_FLAG
  SCORE_REVIEW
  SCORE_MANUAL_RESCORE
  SESSION_ADMIN_VIEW_DETAIL

  MOCK_INTERVIEW_ADMIN_VIEW_DETAIL
  MOCK_INTERVIEW_ADMIN_RETRY_SCORING
}

enum MockInterviewStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  SCORING
  SCORED
  ABANDONED
}

enum MockInterviewMode {
  TOPIC
  CUSTOM
  MIXED
}

enum MockQuestionAnswerStatus {
  PENDING
  ANSWERED
  SKIPPED
}

enum MockQuestionScoreStatus {
  PENDING
  QUEUED
  SCORED
  FAILED
  SKIPPED
}

enum MockOverviewStatus {
  PENDING
  GENERATED
  FALLBACK
  FAILED
}

enum MockCvAnalysisStatus {
  PENDING
  ANALYZING
  READY
  UNSUPPORTED
  NEEDS_REUPLOAD
  FAILED
}

enum MockCvQuestionGenerationStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum MockCvReadiness {
  NOT_READY
  NEEDS_PRACTICE
  READY
}

enum MockCvExtractionQuality {
  HIGH
  MEDIUM
  LOW
}

enum MockCvDomain {
  SOFTWARE_ENGINEERING
  QUALITY_ASSURANCE
  DEVOPS
  DATA
  BUSINESS_ANALYSIS
  PRODUCT_MANAGEMENT
  UX_UI_DESIGN
}

enum MockCvQuestionSource {
  QUESTION_BANK
  AI_GENERATED
}

enum MockCvQuestionFocusArea {
  PROJECT
  EXPERIENCE
  TECHNICAL_DEPTH
  CLAIM_VERIFICATION
}

enum UsageStatus {
  PENDING
  CONSUMED
  CANCELED
}

// ─── Models ──────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String? //  null nếu tài khoản đăng nhập bằng Google (không có mật khẩu)
  name          String
  role          Role     @default(USER)
  emailVerified Boolean  @default(false) // true sau khi xác thực email qua mã 6 số; Google = true sẵn
  isLock        Boolean  @default(false) // true = admin khóa tài khoản, chặn đăng nhập
  googleId      String?  @unique // Google "sub" — gắn khi đăng nhập bằng Google
  avatarUrl     String? //         Ảnh đại diện (lấy từ Google "picture")
  createdAt     DateTime @default(now())

  sessions         Session[]
  subscription     Subscription? // 1–1: mỗi user tối đa 1 subscription
  orders           Order[]
  grantedOrders    Order[]           @relation("OrderGrantedBy") // các đơn admin này cấp thủ công
  usageLogs        UsageLog[]
  reviewedScores   Score[]           @relation("ScoreReviewedBy") // các Score admin này đã review/chấm lại thủ công
  supportMessages  SupportMessage[] // hội thoại hỗ trợ (1 thread liên tục / user, cả tin user gửi lẫn admin trả lời)
  favorites        Favorite[]
  mockInterviews   MockInterview[]
  mockCvs          MockCv[]
  mockCvInterviews MockCvInterview[]
}

model Topic {
  id       String  @id @default(uuid())
  slug     String  @unique // vd: "javascript", "nodejs", "react"
  name     String //         vd: "JavaScript", "Node.js", "React"
  iconUrl  String? // URL ảnh icon trên Cloudflare R2 (chỉ có ở child topic)
  parentId String? // null = parent topic (nhóm); non-null = child topic

  // Restrict: xóa topic cha khi còn topic con phải bị chặn — buộc admin chuyển/xóa con trước,
  // tránh con bị "mồ côi" (parentId = null) mà vẫn mang iconUrl kiểu con, sai lệch phân cấp hiển thị.
  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children Topic[] @relation("TopicHierarchy")

  questions           Question[]
  mockInterviews      MockInterview[]
  mockInterviewTopics MockInterviewTopic[]
}

model Question {
  id      String @id @default(uuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  content          String // Nội dung câu hỏi
  detailAnswerKey  String   @default("") // Đáp án chi tiết (markdown)
  answerKeySummary String // Đáp án chuẩn tóm tắt
  answerKeywords   String[] // Các từ khóa cần đề cập

  level      Level
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())

  sessions               Session[]
  favorites              Favorite[]
  mockInterviewQuestions MockInterviewQuestion[]
  mockCvQuestions        MockCvQuestion[]        @relation("MockCvQuestionBank")

  @@index([isActive, topicId]) // browse/random/admin-list: luôn lọc isActive, thường kèm topicId
  @@index([isActive, createdAt]) // public latest questions
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Null với câu do AI sinh trong Mock CV; dữ liệu chấm khi đó lấy từ snapshot MockCvInterviewQuestion.
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  audioUrl   String // URL file audio trên Cloudflare R2
  transcript String // Transcript từ Groq Whisper
  duration   Int //    Thời gian ghi âm (giây)

  createdAt DateTime @default(now())

  score                   Score?
  improvement             Improvement?
  mockInterviewQuestion   MockInterviewQuestion?
  mockCvInterviewQuestion MockCvInterviewQuestion?

  @@index([userId, createdAt]) // dashboard: thống kê/lịch sử/heatmap theo user + thời gian
  @@index([questionId]) // findByQuestion + admin filter theo topic (join qua questionId)
}

model MockInterview {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  mode   MockInterviewMode   @default(TOPIC)
  status MockInterviewStatus @default(DRAFT)

  title   String
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  level           Level?
  totalQuestions  Int
  durationSeconds Int

  startedAt          DateTime?
  expiresAt          DateTime?
  submittedAt        DateTime?
  scoredAt           DateTime?
  lastScoringRetryAt DateTime?

  averageTechnicalScore    Float?
  averageCompletenessScore Float?
  averageClarityScore      Float?
  overallScore             Float?

  summary             String?
  strengths           String[] @default([])
  weaknesses          String[] @default([])
  nextRecommendations String[] @default([])

  overviewStatus MockOverviewStatus @default(PENDING)
  overviewError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions  MockInterviewQuestion[]
  topicLinks MockInterviewTopic[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status, createdAt]) // admin: danh sách mock toàn hệ thống theo trạng thái và thời gian tạo
  @@index([status, updatedAt]) // admin: phát hiện các bài SCORING bị kẹt theo thời điểm cập nhật
}

model MockInterviewQuestion {
  id              String        @id @default(uuid())
  mockInterviewId String
  mockInterview   MockInterview @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  sessionId String?  @unique
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  order Int

  answerStatus MockQuestionAnswerStatus @default(PENDING)
  scoreStatus  MockQuestionScoreStatus  @default(PENDING)
  scoreError   String?

  answeredAt DateTime?
  skippedAt  DateTime?

  @@unique([mockInterviewId, questionId])
  @@unique([mockInterviewId, order])
  @@index([mockInterviewId, order])
  @@index([scoreStatus, mockInterviewId]) // admin: lọc nhanh các mock có câu chấm lỗi/chờ lâu
}

model MockInterviewTopic {
  id String @id @default(uuid())

  mockInterviewId String
  mockInterview   MockInterview @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  order Int

  @@unique([mockInterviewId, topicId])
  @@unique([mockInterviewId, order])
  @@index([topicId])
}

// CV gốc do user tải lên. fileKey luôn là khóa private trên R2, không lưu URL public.
model MockCv {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Vị trí user muốn phỏng vấn, ví dụ: "Backend Developer". Không suy luận hay lưu cấp độ.
  targetRole String
  fileKey    String @unique
  fileName   String
  mimeType   String
  fileSize   Int

  // Nội dung trích xuất chỉ phục vụ AI nội bộ; tuyệt đối không trả về client, log hoặc audit.
  extractedText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis   MockCvAnalysis?
  questions  MockCvQuestion[]
  interviews MockCvInterview[]

  @@index([userId, createdAt])
}

// Vòng đời và hồ sơ được AI rút ra từ CV. Row này được tạo PENDING trước khi enqueue job phân tích.
model MockCvAnalysis {
  id       String @id @default(uuid())
  mockCvId String @unique
  mockCv   MockCv @relation(fields: [mockCvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  status            MockCvAnalysisStatus     @default(PENDING)
  extractionQuality MockCvExtractionQuality?
  detectedDomains   MockCvDomain[]           @default([])
  eligibilityReason String?
  analysisError     String?
  lastRetryAt       DateTime?
  analysisAttempt   Int                      @default(0)
  analysisStartedAt DateTime?

  questionGenerationStatus    MockCvQuestionGenerationStatus @default(PENDING)
  questionGenerationAttempt   Int                            @default(0)
  questionGenerationStartedAt DateTime?
  questionGeneratedAt         DateTime?
  questionGenerationError     String?
  questionPromptVersion       String?
  requestedQuestionCount      Int?
  requestedDurationSeconds    Int      @default(900)
  selectedBankQuestionCount   Int?
  generatedQuestionCount      Int?

  // Chỉ có giá trị khi status = READY; mảng rỗng giúp lưu được row PENDING/FAILED an toàn.
  summary             String?
  topicSlugs          String[] @default([])
  technicalSkills     String[] @default([])
  experienceSignals   String[] @default([])
  strengths           String[] @default([])
  gapsForTargetRole   String[] @default([])
  interviewFocusAreas String[] @default([])
  claimsToVerify      String[] @default([])
  projects            Json?
  promptVersion       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([questionGenerationStatus, updatedAt])
}

// Bộ câu hỏi đã chuẩn bị cho một CV. Nội dung là snapshot để câu từ bank không đổi khi admin sửa Question.
model MockCvQuestion {
  id       String @id @default(uuid())
  mockCvId String
  mockCv   MockCv @relation(fields: [mockCvId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  bankQuestionId String?
  bankQuestion   Question? @relation("MockCvQuestionBank", fields: [bankQuestionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  source    MockCvQuestionSource
  focusArea MockCvQuestionFocusArea?
  order     Int

  content          String
  answerKeySummary String
  answerKeywords   String[]
  rationale        String?
  createdAt        DateTime @default(now())

  interviews MockCvInterviewQuestion[]

  @@unique([mockCvId, order])
  @@index([mockCvId, source])
  @@index([bankQuestionId])
}

// Một lần trả lời bộ câu hỏi từ CV. Tách khỏi MockInterview vì cách tạo câu hỏi và dữ liệu nguồn khác nhau.
model MockCvInterview {
  id       String @id @default(uuid())
  mockCvId String
  mockCv   MockCv @relation(fields: [mockCvId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  title           String
  status          MockInterviewStatus @default(DRAFT)
  totalQuestions  Int
  durationSeconds Int

  startedAt          DateTime?
  expiresAt          DateTime?
  submittedAt        DateTime?
  scoredAt           DateTime?
  lastScoringRetryAt DateTime?

  averageTechnicalScore    Float?
  averageCompletenessScore Float?
  averageClarityScore      Float?
  overallScore             Float?

  summary                 String?
  strengths               String[]           @default([])
  weaknesses              String[]           @default([])
  nextRecommendations     String[]           @default([])
  overviewStatus          MockOverviewStatus @default(PENDING)
  overviewError           String?
  readiness               MockCvReadiness?
  claimsToPrepareEvidence String[]           @default([])
  overviewPromptVersion   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions MockCvInterviewQuestion[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([mockCvId, createdAt])
}

// Snapshot câu hỏi cho từng lần phỏng vấn để việc tạo lại một interview không làm ghi đè lịch sử.
model MockCvInterviewQuestion {
  id                String          @id @default(uuid())
  mockCvInterviewId String
  mockCvInterview   MockCvInterview @relation(fields: [mockCvInterviewId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mockCvQuestionId  String?
  mockCvQuestion    MockCvQuestion? @relation(fields: [mockCvQuestionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessionId         String?         @unique
  session           Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  order     Int
  source    MockCvQuestionSource
  focusArea MockCvQuestionFocusArea?

  content          String
  answerKeySummary String
  answerKeywords   String[]
  answerStatus     MockQuestionAnswerStatus @default(PENDING)
  scoreStatus      MockQuestionScoreStatus  @default(PENDING)
  scoreError       String?
  answeredAt       DateTime?
  skippedAt        DateTime?

  @@unique([mockCvInterviewId, order])
  @@index([mockCvInterviewId, order])
  @@index([scoreStatus, mockCvInterviewId])
}

model Score {
  id        String  @id @default(uuid())
  sessionId String  @unique
  // Cascade: Score là bảng chi tiết phụ thuộc Session, không có ý nghĩa đứng riêng —
  // xóa Session (DELETE /sessions/:id) phải tự dọn theo, không được chặn bởi FK.
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Điểm chấm bởi DeepSeek (0–10)
  technicalScore    Int
  completenessScore Int
  clarityScore      Int

  matchedKeywords String[] // Keyword đã nhận diện (đã chuẩn hóa, tính cả fuzzy STT)
  missedKeywords  String[] // Keyword chưa đề cập

  summary      String // Nhận xét tóm tắt (1 câu) bằng tiếng Việt
  improvements String[] // Các gợi ý cải thiện cụ thể

  promptVersion String? // Version của SCORING_PROMPT tại thời điểm chấm — trace khi đổi prompt/model. Null = tạo trước khi có tính năng này.

  flaggedAt      DateTime? // User báo điểm chấm sai lúc nào — null = chưa bị báo cáo
  flagReason     String? // Lý do user ghi khi báo cáo (tùy chọn)
  flagResolvedAt DateTime? // Admin xử lý xong report lúc nào — null = đang chờ (chỉ có ý nghĩa khi flaggedAt khác null)
  adminNote      String? // Ghi chú nội bộ của admin khi xem xét report

  manuallyEditedAt DateTime? // Lúc admin ghi đè điểm/nhận xét thủ công — null = điểm gốc từ AI
  reviewedById     String? // Admin thao tác review/rescore gần nhất
  reviewedBy       User?     @relation("ScoreReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([flaggedAt, flagResolvedAt]) // admin: lọc hàng đợi báo cáo (đang chờ/đã xử lý)
}

model Improvement {
  id        String  @id @default(uuid())
  sessionId String  @unique
  // Cascade: cùng lý do với Score — Improvement chỉ có ý nghĩa gắn liền với Session gốc.
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  improvedAnswer String // Bản câu trả lời đã được DeepSeek viết lại tốt hơn
  annotations    Json // Annotation[]: { originalSegment, issue, suggestion }
  keyChanges     String[] // Các thay đổi quan trọng, tóm tắt ngắn gọn

  promptVersion String? // Version của IMPROVEMENT_PROMPT tại thời điểm tạo — trace khi đổi prompt/model. Null = tạo trước khi có tính năng này.

  createdAt DateTime @default(now())
}

model Plan {
  id           String  @id @default(uuid())
  slug         String  @unique // "pro-1m", "pro-3m"
  name         String
  description  String?
  priceVnd     Int //                VND, số nguyên
  durationDays Int //                kỳ hạn tính theo ngày: 7 / 30 / 90 (cộng vào expiresAt khi kích hoạt)

  // ── Limits/quota (cột có kiểu + JSON dự phòng) ──
  isUnlimited      Boolean @default(false) // true = không giới hạn lượt
  dailyScoreLimit  Int? //                    null = không giới hạn theo ngày
  weeklyScoreLimit Int? //                    null = không giới hạn theo tuần
  limits           Json? //                   mở rộng các limit khác sau này

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0) // thứ tự hiển thị ở trang Pricing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  orders        Order[]
}

model Subscription {
  id     String @id @default(uuid())
  userId String @unique //                        1 user ↔ 1 subscription (tái sử dụng dòng khi gia hạn)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  status     SubscriptionStatus @default(ACTIVE)
  startedAt  DateTime           @default(now())
  expiresAt  DateTime //                          luôn có hạn (gói 1 hoặc 3 tháng)
  canceledAt DateTime?

  // Đã gửi email nhắc gia hạn (còn ~2 ngày) cho CHU KỲ hiện tại — chống gửi lặp.
  // Reset về null mỗi khi gia hạn/cấp mới để chu kỳ sau lại được nhắc.
  renewalReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[] // các đơn đã tạo/gia hạn sub này

  @@index([status, expiresAt]) // job hạ cấp: tìm ACTIVE & expiresAt < now
}

model Order {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  subscriptionId String? //                gán sau khi kích hoạt/gia hạn
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  amountVnd Int //                            số tiền kỳ vọng (snapshot từ Plan tại thời điểm tạo)
  status    OrderStatus @default(PENDING)
  provider  String      @default("sepay") //  "sepay" | "manual" (cấp tay)

  // ── Cấp gói thủ công (admin / hỗ trợ KH) ──
  note        String? //          lý do cấp thủ công
  grantedById String? //          admin thực hiện cấp tay (null nếu đơn mua thường)
  grantedBy   User?   @relation("OrderGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  transferCode  String    @unique // mã nhúng trong nội dung VietQR để khớp webhook (alphanumeric, ngắn)
  providerTxnId String?   @unique // id giao dịch Sepay — idempotency khi webhook lặp
  paidAt        DateTime?
  rawPayload    Json? //           payload webhook để đối soát/tra cứu

  expiresAt DateTime //            hạn hiệu lực QR/đơn (vd now + 15–30 phút)
  periodEnd DateTime? //           ngày hết hạn subscription mà đơn này tạo ra (snapshot lúc kích hoạt)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status, expiresAt]) // cron dọn đơn PENDING hết hạn; cũng phục vụ lọc riêng theo status
  @@index([createdAt]) // admin: sổ cái sắp theo ngày tạo (không luôn lọc theo userId)
  @@index([subscriptionId]) // admin: lịch sử đơn theo 1 subscription
}

// 1 dòng = 1 lượt luyện tập; PENDING được tạo trước Whisper, CONSUMED sau khi thao tác thành công.
model UsageLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  sessionId String? //  tham chiếu lỏng (không FK — session có thể bị xóa ở nhánh điểm 0)
  // PENDING giữ chỗ quota trước khi gọi dịch vụ tốn phí; reservation hết hạn sẽ không còn được tính.
  status    UsageStatus @default(CONSUMED)
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt]) // COUNT lượt dùng theo kỳ (ngày/tháng)
  @@index([userId, status, expiresAt])
}

// 1 thread liên tục / user (không có khái niệm "ticket" riêng) — gồm cả tin
// user gửi lẫn admin trả lời, phân biệt qua senderRole.
model SupportMessage {
  id     String @id @default(uuid())
  userId String
  // Cascade: tin nhắn hỗ trợ chỉ có ý nghĩa gắn với user còn tồn tại — không
  // phải dữ liệu tài chính/audit cần giữ lại như Order.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  senderRole Role // USER = user gửi cho admin; ADMIN = admin trả lời user này
  content    String  @default("") // caption/text; rỗng nếu tin chỉ có ảnh
  imageUrl   String? //             URL ảnh trên R2; null nếu tin chỉ có text

  createdAt DateTime @default(now())

  @@index([userId, createdAt]) // load lịch sử theo thread, sắp theo thời gian
}

// 1 dòng = 1 câu hỏi user đã lưu vào "Câu hỏi đã lưu". Restrict trên Question vì
// Question không bao giờ bị hard-delete (chỉ soft-delete isActive=false).
model Favorite {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId, createdAt]) // recent list + phân trang, mới nhất trước
}

model AuditLog {
  id String @id @default(uuid())

  actorType  AuditActorType
  actorId    String?
  actorEmail String?

  action AuditAction

  entityType   String
  entityId     String?
  targetUserId String?

  method    String?
  path      String?
  ip        String?
  userAgent String?

  before   Json?
  after    Json?
  metadata Json?

  success   Boolean @default(true)
  errorCode String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([targetUserId, createdAt])
}
